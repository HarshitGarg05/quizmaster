{
    "version": 2,
    "builds": [
        {
            "src": "frontend/package.json",
            "use": "@vercel/static-build",
            "config": {
                "distDir": "dist"
            }
        },
        {
            "src": "backend/server.js",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "backend/server.js"
        },
        {
            "src": "/ranks/(.*)",
            "dest": "frontend/ranks/$1"
        },
        {
            "src": "/(assets/.*)",
            "dest": "frontend/$1"
        },
        {
            "src": "/((?!api/).*)",
            "dest": "frontend/index.html"
        }
    ]
}